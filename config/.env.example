# wheel-stack environment template
# Copy to .env (repo root) and fill in your own keys. NEVER commit .env.

# --- Alpaca (broker + market data) ---
# Paper keys: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your-key-here
ALPACA_SECRET_KEY=your-key-here
# Keep true unless you have explicitly decided to trade real money.
IS_PAPER=true

# --- Finnhub (earnings calendar, fundamentals fallback) ---
# Free key: https://finnhub.io
FINNHUB_API_KEY=your-key-here
# Optional: real-time earnings webhook (clears the cached calendar instantly).
# Point Finnhub's webhook at your own HTTPS URL; the receiver is scripts/webhook_server.py.
FINNHUB_WEBHOOK_SECRET=your-key-here
FINNHUB_WEBHOOK_URL=https://your-domain.example/webhooks/finnhub-earnings

# --- Alpha Vantage (primary fundamentals / volatility / dividends) ---
# Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-key-here

# --- Optionable dashboard sync (optional) ---
OPTIONABLE_URL=http://localhost:8096
OPTIONABLE_DATA_DIR=/path/to/optionable-data

# --- Strategy tuning (all optional; these override config/params.py) ---
# MAX_RISK=90000
# MIN_PREMIUM=0.20
# SCORE_MIN=0.02
# WATCHLIST=AAPL,F,SPY        # comma-separated; replaces config/symbol_list.txt
# SGOV_ENABLED=false          # Alpaca-paper cash sweep; must stay off for live

# --- Optional: LLM enrichment of the market-context analyzer ---
OPENAI_API_KEY=

# --- Runtime ---
TZ=America/Los_Angeles
NODE_ENV=production
