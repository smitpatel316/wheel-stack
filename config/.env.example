# .env.example for wheel-stack
# Copy to .env and fill real keys - NEVER commit .env

# Alpaca Trading (paper $100k PA3WFOAHE2C6)
ALPACA_API_KEY=your-key-here
ALPACA_SECRET_KEY=your-key-here
IS_PAPER=true

# Finnhub for earnings calendar + webhook
# Get from https://finnhub.io dashboard, used in core/earnings_calendar.py + webhook handler
FINNHUB_API_KEY=your-key-here3gyour-key-here40
# Public webhook URL (cloudflared)
FINNHUB_WEBHOOK_SECRET=your-key-here50
FINNHUB_WEBHOOK_URL=https://webhook.smitpatel.net/webhooks/finnhub-earnings

# Alpha Vantage for fundamentals, volatility, dividends
# Get from https://www.alphavantage.co/support/#api-key, 131 tools via MCP https://mcp.alphavantage.co
ALPHA_VANTAGE_API_KEY=your-key-here

# Optionable tracker
OPTIONABLE_URL=http://localhost:8096
# For Pi deployment host mount path still /home/smitpatel316/optionable-data
OPTIONABLE_DATA_DIR=/home/smitpatel316/optionable-data

# Optional: OpenAI for LLM enrichment of context_analyzer (BN nodes/edges reasoning)
OPENAI_API_KEY=

# Optional: Slack/Telegram alerts (future)
your-key-here=

# Deployment env
TZ=America/Los_Angeles
NODE_ENV=production
