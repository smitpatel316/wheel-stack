# ============================================================================
# LADDER PHASE 1 — LIVE MONEY CONFIG (example)
# ============================================================================
# *** DO NOT USE without Smit's explicit go-ahead. ***
# *** Going live requires his direct approval, every phase, every time. ***
#
# The Ladder Phase 1 (September 2026): $1,000 real money, F only, 1 contract,
# tiny thresholds so the engine can actually trade on a $1k account.
#
# How to use (when — and only when — Smit says go):
#   1. Copy this file to .env.phase1 and fill in the LIVE Alpaca keys.
#   2. Review every line. Then review it again.
#   3. ./wheel doctor must be all green (it refuses PK/AK key mismatches).
#   4. Start with: env $(grep -v '^#' .env.phase1 | xargs) ... or rename to .env
#      on the live host. Never commit real keys — this repo is PUBLIC.
#
# Env always wins over config/params.py defaults — no source edits needed.
# ============================================================================

# --- Broker (LIVE keys start with AK…; paper keys with PK…) -----------------
ALPACA_API_KEY=REPLACE_WITH_LIVE_KEY
ALPACA_SECRET_KEY=REPLACE_WITH_LIVE_SECRET
IS_PAPER=false

# --- Data feeds --------------------------------------------------------------
FINNHUB_API_KEY=REPLACE_ME
ALPHA_VANTAGE_API_KEY=REPLACE_ME

# --- Phase 1 risk envelope ---------------------------------------------------
MAX_RISK=1000          # hard ceiling: one F CSP (~$700-800 collateral) fits, nothing more
MIN_PREMIUM=0.10       # accept $0.10 premium/contract on a small account
SCORE_MIN=0.01         # minimal score gate; fundamentals/earnings/dividend filters still apply
WATCHLIST=F            # Ford only — do not widen without Smit's approval

# --- SGOV sweep --------------------------------------------------------------
# MUST stay off for live: SGOV is an Alpaca-paper workaround for the missing
# cash sweep. Real brokers pay interest on cash natively.
SGOV_ENABLED=false

# --- Notes -------------------------------------------------------------------
# - Contract count is 1 by design: the engine sells single contracts sized by
#   collateral (100 x strike); MAX_RISK=1000 makes a second contract impossible.
# - Roll rules, closer rules, spread limits, and fundamentals filters are NOT
#   overridden here — they stay at the v2.7 defaults on purpose.
# - Never carry a margin debit: the engine sizes from settled cash/options BP;
#   ./wheel doctor fails the run if cash goes negative.
