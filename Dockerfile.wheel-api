FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
COPY config/ ./config/
COPY core/ ./core/
COPY app_logging/ ./app_logging/
COPY scripts/ ./scripts/
RUN pip install --no-cache-dir -e . && pip install fastapi uvicorn
EXPOSE 8097
ENV OPTIONABLE_URL=http://optionable:8080
CMD ["python", "-m", "scripts.wheel_api"]
